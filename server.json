{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.iamvirul/choreo-docs-mcp-server",
  "description": "Semantic search over Choreo Labs (formerly WSO2) docs: APIM, IS, MI, Choreo, Ballerina, via RAG + pgvector.",
  "repository": {
    "url": "https://github.com/iamvirul/choreo-docs-mcp-server",
    "source": "github"
  },
  "version": "1.3.16",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "choreo-docs-mcp-server",
      "version": "1.3.16",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "DATABASE_URL",
          "description": "PostgreSQL connection string for pgvector (e.g. postgresql://user:pass@localhost:5432/choreodocs)",
          "isRequired": true,
          "isSecret": false,
          "format": "string"
        },
        {
          "name": "EMBEDDING_PROVIDER",
          "description": "Embedding backend to use: ollama (default, local), openai, gemini, or voyage",
          "isRequired": false,
          "isSecret": false,
          "format": "string"
        },
        {
          "name": "OPENAI_API_KEY",
          "description": "Required only when EMBEDDING_PROVIDER=openai",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "GEMINI_API_KEY",
          "description": "Required only when EMBEDDING_PROVIDER=gemini",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "VOYAGE_API_KEY",
          "description": "Required only when EMBEDDING_PROVIDER=voyage",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
